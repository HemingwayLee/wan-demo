# Copy to .env to override. Docker Compose reads .env automatically.

# Where the backend finds ComfyUI (default: ComfyUI on this Mac, started by scripts/run_comfyui.sh).
# COMFYUI_URL=http://host.docker.internal:8188

# Wan-Animate GGUF file in comfyui/models/unet (download others with ANIMATE_QUANT=Q5_K_M scripts/download_models.sh).
# ANIMATE_MODEL=Wan2.2-Animate-14B-Q4_K_M.gguf
